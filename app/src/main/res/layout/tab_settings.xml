<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:accessibilityPaneTitle="@string/tab_settings"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_card">

        <com.alexamy.unlockcounter.WallpaperPreview
            android:id="@+id/settings_preview"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="12dp"
            android:contentDescription="@string/preview_description" />
    </FrameLayout>

    <Button
        android:id="@+id/set_wallpaper"
        style="@style/PillButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:text="@string/set_wallpaper" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp">

            <Button android:id="@+id/chip_image" style="@style/Chip" android:text="@string/section_image" />
            <Button android:id="@+id/chip_color" style="@style/Chip" android:text="@string/section_color" />
            <Button android:id="@+id/chip_size" style="@style/Chip" android:text="@string/size" />
            <Button android:id="@+id/chip_position" style="@style/Chip" android:text="@string/position" />
            <Button android:id="@+id/chip_font" style="@style/Chip" android:text="@string/font" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/section_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/pick_image"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button"
                        android:contentDescription="@string/pick_image"
                        android:src="@drawable/ic_image" />

                    <ImageButton
                        android:id="@+id/remove_image"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button"
                        android:contentDescription="@string/remove_image"
                        android:src="@drawable/ic_delete"
                        android:tint="@color/danger" />
                </LinearLayout>

                <TextView style="@style/SliderLabel" android:labelFor="@id/image_x" android:text="@string/image_x" />
                <SeekBar android:id="@+id/image_x" style="@style/Slider" android:max="100" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:id="@+id/color_preview"
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />

                <TextView style="@style/SliderLabel" android:labelFor="@id/hue" android:text="@string/hue" />
                <SeekBar android:id="@+id/hue" style="@style/Slider" android:max="360" />
                <TextView style="@style/SliderLabel" android:labelFor="@id/saturation" android:text="@string/saturation" />
                <SeekBar android:id="@+id/saturation" style="@style/Slider" android:max="100" />
                <TextView style="@style/SliderLabel" android:labelFor="@id/brightness" android:text="@string/brightness" />
                <SeekBar android:id="@+id/brightness" style="@style/Slider" android:max="100" />
                <TextView style="@style/SliderLabel" android:labelFor="@id/opacity" android:text="@string/opacity" />
                <SeekBar android:id="@+id/opacity" style="@style/Slider" android:max="100" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/SliderLabel" android:labelFor="@id/size" android:text="@string/size" />
                <SeekBar android:id="@+id/size" style="@style/Slider" android:max="100" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/positions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:columnCount="3" />

            <GridLayout
                android:id="@+id/fonts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2" />
        </FrameLayout>
    </ScrollView>
</LinearLayout>
