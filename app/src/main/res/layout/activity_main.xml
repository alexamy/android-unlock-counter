<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        android:text="@string/app_name"
        android:textColor="@color/text"
        android:textSize="32sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/bg_segments"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/show_history"
            style="@style/Segment"
            android:text="@string/tab_history" />

        <TextView
            android:id="@+id/show_settings"
            style="@style/Segment"
            android:text="@string/tab_settings" />

        <TextView
            android:id="@+id/show_system"
            style="@style/Segment"
            android:text="@string/tab_system" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/tab_history"
            layout="@layout/tab_history" />

        <include
            android:id="@+id/tab_settings"
            layout="@layout/tab_settings" />

        <include
            android:id="@+id/tab_system"
            layout="@layout/tab_system" />
    </FrameLayout>
</LinearLayout>
